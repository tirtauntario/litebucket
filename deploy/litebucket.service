# systemd unit for a standalone litebucket install. See docs/installation.md.
#   install -m 0644 litebucket.service /etc/systemd/system/litebucket.service
#   systemctl daemon-reload && systemctl enable --now litebucket
[Unit]
Description=litebucket S3-compatible object storage
Documentation=https://github.com/tirtauntario/litebucket
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=simple
User=litebucket
Group=litebucket
ExecStart=/usr/local/bin/litebucket serve --config /etc/litebucket/config.toml
# /run/litebucket holds the admin API socket (config: [admin] socket =
# "/run/litebucket/admin.sock"). Manage keys with
#   sudo -u litebucket litebucket admin --config /etc/litebucket/config.toml key list
RuntimeDirectory=litebucket
RuntimeDirectoryMode=0700
# SIGTERM drains requests within maintenance.shutdown_grace_seconds (30 s by
# default); allow a margin before systemd escalates to SIGKILL.
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=2
LimitNOFILE=8192

# Hardening: only the data directory is writable.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/litebucket
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
